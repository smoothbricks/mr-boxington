# The repository shell: devenv.nix declares it and devenv.lock pins it. A
# cowshed workspace activates it for every job, so Cargo build-state discovery
# asks this shell's cargo, and the host's mbx route leads PATH ahead of it
# (smoothbricks specs/cowshed/15_capabilities.md, "Detection inputs";
# 11_shell.md, "Canonical mbx environment").
if ! has devenv; then
  log_error "devenv is not on PATH: install it (https://devenv.sh/getting-started/), then run direnv reload"
  exit 1
fi
eval "$(devenv direnvrc)"
# use_devenv answers an evaluation that failed with `exit 0` and keeps whatever
# environment the shell had, so a job would run with none of this shell's tools
# and nothing said. Entry fails instead: direnv's exit hook (__dump_at_exit)
# still dumps the diff, now with this status. An inherited DEVENV_ROOT is
# another shell's, never this evaluation's.
unset DEVENV_ROOT
mbx_require_devenv() {
  local status=$?
  [ -n "${DEVENV_ROOT-}" ] && return "$status"
  log_error "devenv built no environment (see above): this checkout's shell is not entered"
  return 1
}
trap 'mbx_require_devenv; __dump_at_exit' EXIT
use devenv
trap __dump_at_exit EXIT
unset -f mbx_require_devenv

# A cowshed workspace's environment, for interactive shells inside one, then
# untracked local additions; an absent file is skipped.
source_env_if_exists .cowshed/env
source_env_if_exists .envrc-local